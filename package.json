{
  "name": "joblesss",
  "version": "0.1.0",
  "description": "A local job search app that keeps your career record as Markdown and uses Claude Code agents to score jobs and prepare applications.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "agent": "tsx scripts/run-agent.ts",
    "jobs:fetch": "tsx scripts/jobs.ts fetch",
    "jobs:score": "tsx scripts/jobs.ts score",
    "jobs:daily": "tsx scripts/jobs.ts daily",
    "inbox": "tsx scripts/inbox.ts",
    "schedule": "tsx scripts/install-launchd.ts",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.32.1"
}
